# ====================================================================
# StudyMind AI / StudySync AI - Cấu hình biến môi trường (Environment Configuration)
# ====================================================================

# GEMINI_API_KEY: Bắt buộc để thực hiện các cuộc gọi AI (Tóm tắt, Flashcard, Quiz, Chatbot, Mind Map, Nhận diện giọng nói).
# AI Studio tự động tiêm biến này ở phía server. Không đặt API key ở frontend.
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3-flash-preview"

# APP_BASE_URL: URL ứng dụng đang chạy (AI Studio tự động cung cấp hoặc localhost khi test)
APP_BASE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# PORT: Cổng chạy server full-stack (mặc định 3000)
PORT=3000

# ====================================================================
# Cấu hình Thanh toán Ngân hàng (TPBank)
# ====================================================================
PAYMENT_BANK_NAME="TPBank"
PAYMENT_BANK_ACCOUNT_NUMBER="00000493116"
PAYMENT_BANK_ACCOUNT_NAME="DINH THI HUYEN ANH"
PAYMENT_QR_IMAGE_URL="/images/tpbank_qr.png"
PAYMENT_MOMO_QR_IMAGE_URL="/images/momo_qr.png"
PAYMENT_ZALOPAY_QR_IMAGE_URL="/images/zalopay_qr.png"
PAYMENT_INSTRUCTIONS="Vui lòng ghi đúng mã đơn hàng trong nội dung chuyển khoản."

# ====================================================================
# Cấu hình Gửi Email SMTP (Hỗ trợ Gmail App Password, OAuth2, SendGrid, Amazon SES, Resend)
# Lưu ý với Gmail: Cần bật Xác minh 2 bước (2FA) và tạo Mật khẩu ứng dụng (App Password 16 ký tự).
# ====================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
MAIL_FROM="StudySync AI <your-email@gmail.com>"
RESEND_API_KEY=""

# ====================================================================
# Cấu hình Cổng thanh toán MoMo / ZaloPay / Stripe
